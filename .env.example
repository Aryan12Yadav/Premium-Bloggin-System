# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env and provide your actual secrets
# ==============================================================================

# LLM / AI Configuration
OPENAI_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Market Engine Configuration
MARKET_SYMBOL=BTCUSDT
EXCHANGE_WS_URL=wss://socket.delta.exchange
EXCHANGE_REST_URL=https://api.delta.exchange
HEATMAP_PRICE_BIN_WIDTH=50
MARKET_ENGINE_URL=http://localhost:8080

# Database Configuration
DATABASE_URL=sqlite:///./research.db

# Server Ports
PORT=8080
